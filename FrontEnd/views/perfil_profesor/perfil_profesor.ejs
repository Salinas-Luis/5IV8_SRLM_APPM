<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MaxGrade | Dashboard</title>
    <link rel="stylesheet" href="/public/css/styleprofesor.css">
    <script src="https://kit.fontawesome.com/101326ea39.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div class="container-header">
        <div class="divacio"></div>
        <div class="divimg"><img src="/public/img/maxgradeplacapng.png" alt="MaxGrade"></div>
        <div class="irperfil">
            <a href="/perfilconfig">
                <img src="/public/img/usuario-negro-forma-de-cerca.png" alt="Perfil">
            </a>
        </div>
    </div>

    <div class="container-nav">
        <a href="/perfil_profesor">Inicio | </a>
        <a href="#" onclick="cerrarSesion()">Cerrar Sesión</a>
    </div>

    <div class="container-body">
        <h2 id="bienvenida-usuario" style="margin-top: 20px;">Hola, Cargando...</h2>
        <div id="lista-tareas-existentes">
            </div>
            <div class="seccion-tareas">
                <p style="font-size: 25px; margin-top: 20px; color: black;">Crear nueva tarea</p>
                <div class="formulario-tarea">
                    <input type="text" id="tarea-titulo" placeholder="Título de la tarea (ej: Práctica 1)">
                    <textarea id="tarea-desc" placeholder="Instrucciones detalladas para los alumnos..."></textarea>

                    <div class="inputs-inline">
                        <select id="tarea-grupo">
                            <option value="" disabled selected>Seleccionar Grupo (ej: 5IV8)</option>
                            </select>
                            <select id="tarea-materia" disabled>
                                <option value="" disabled selected>Selecciona primero un grupo</option>
                            </select>
                        <input type="date" id="tarea-fecha">
                    </div>
                    
                    <button id="btnPublicarTarea" class="btn-guardar" >Publicar Tarea</button>
                </div>
            </div>
            <div id="contenedor-tareas-profesor" class="mt-4">
            </div>
            <div class="modal fade" id="modalEditarTarea" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="border-radius: 15px;">
                        <div class="modal-header bg-dark text-white" style="border-radius: 15px 15px 0 0;">
                            <h5 class="modal-title">Editar Tarea</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="edit-tarea-id">
                            <div class="mb-3">
                                <label class="form-label">Título</label>
                                <input type="text" id="edit-titulo" class="form-control">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Descripción</label>
                                <textarea id="edit-descripcion" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Fecha de Entrega</label>
                                <input type="date" id="edit-fecha" class="form-control">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-primary" onclick="guardarCambiosTarea()">Guardar Cambios</button>
                        </div>
                    </div>
                </div>
            </div>
    </div>




    <div class="container-footer">
        </div>

    <script src="/public/js/profesores.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>