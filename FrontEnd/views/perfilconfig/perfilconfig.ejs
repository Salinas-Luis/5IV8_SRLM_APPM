<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MaxGrade</title>
    <link rel="stylesheet" href="/public/css/styleperfilconfig.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
        <div class="container-header">
            <div class="divacio"></div>
            <div class="divimg"><img src="../img/maxgradeplacapng.png" alt=""></div>
            <div class="irperfil"></div>
        </div>
            <div class="container-nav">
            </div>
                <div class="container-body">
                    <h2>Configuracion de Perfil</h2>
                    <label for="edit-nombre" class="input-group-text w-25" style="margin: 5px;">Nombre:</label>
                    <input type="text" id="edit-nombre" placeholder="Tu nombre" class="form-control inputlog w-25" style="margin: 5px;">
                    
                    <label for="edit-correo" class="input-group-text w-25" style="margin: 5px;">Correo Electrónico:</label>
                    <input type="email" id="edit-correo" placeholder="tu@correo.com" class="form-control inputlog w-25" style="margin: 5px;">
                    <div class="container-btn">
                    <button onclick="guardarCambios()" style="border-radius: 5px; margin: 5px;">Guardar</button>
                    <button onclick="resetearCampos()" style="border-radius: 5px; margin: 5px;">Resetear</button>
                    <button onclick="regresarAlPerfil()" style="border-radius: 5px; margin: 5px;">Regresar</button> 
                    </div>
                </div>
                <script src="/public/js/perfilconfig.js"></script>
</body>
</html>